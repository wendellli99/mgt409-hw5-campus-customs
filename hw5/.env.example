# Copy to .env at the hw5 project root. Never commit the real .env.
PORTKEY_API_KEY=your_private_portkey_key
# Generate a private random value; use the same value for MCP and backend.
# This capability is never exposed to the model or agent toolset.
HUMAN_APPROVAL_TOKEN=replace_with_a_private_random_string
# The model is fixed in code to gpt-6-luna for every shop agent.
MCP_URL=http://127.0.0.1:8001/mcp
